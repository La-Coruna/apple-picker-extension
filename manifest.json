{
  "manifest_version": 3,
  "name": "Apple Picker",
  "version": "0.1.0",
  "description": "Helps you play the Apple Picker game by finding and highlighting valid sum-10 rectangles or lines using CreateJS tile state.",
  "icons": {
    "16": "favicon.png",
    "32": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gamesaien.com/game/fruit_box_a/*",
        "http://www.gamesaien.com/game/fruit_box_a/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://www.gamesaien.com/*",
        "http://www.gamesaien.com/*"
      ]
    }
  ]
}
